# Home Agent configuration. Copy to .env (uv run home-agent init does this) and keep it private:
# it holds credentials, is git-ignored, and should be chmod 600.

# ---------------------------------------------------------------- server
HOME_AGENT_HOST=127.0.0.1
HOME_AGENT_PORT=18789
# Generated by `uv run home-agent init`. Encrypts stored OAuth tokens; do not change after connecting Gmail.
HOME_AGENT_SECRET_KEY=
HOME_AGENT_TIMEZONE=Asia/Shanghai
# Where the database, logs and agent workspace live (default on macOS: ~/Library/Application Support/HomeAgent)
HOME_AGENT_DATA_DIR=
# The address you use from other devices, e.g. https://mac-mini.your-tailnet.ts.net:8443
HOME_AGENT_PUBLIC_URL=
# Extra host names allowed in the Host header (comma separated). *.ts.net, localhost and this Mac's name are allowed.
HOME_AGENT_ALLOWED_HOSTS=
HOME_AGENT_SESSION_DAYS=30
# auto = Secure cookies when reached over HTTPS (Tailscale Serve); always | never to override
HOME_AGENT_COOKIE_SECURE=auto
# macOS: hold a caffeinate assertion while running (system stays awake, display may sleep)
HOME_AGENT_PREVENT_SLEEP=true
HOME_AGENT_LOG_LEVEL=INFO

# ---------------------------------------------------------------- model
# anthropic | ollama | openai_compatible   (can be switched later in Settings)
MODEL_PROVIDER=anthropic
# true = refuse any model endpoint that is not on this Mac / LAN / tailnet (prompts never leave your network)
LOCAL_ONLY=false

# Claude API (billed per use; a Claude.ai or Claude Code subscription does NOT include API access).
# Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  - higher is more thorough and more expensive
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=32000
# Retry a safety-classifier refusal on Anthropic's recommended fallback model (server-side, same request)
ANTHROPIC_REFUSAL_FALLBACK=true

# Local model through Ollama (runs on Apple Silicon with Metal). See: uv run home-agent recommend-model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Context window per request. Ollama's own default is only 4k on machines with < 24 GB, too small for web pages.
OLLAMA_NUM_CTX=32768
# default | on | off  - "thinking" for models that support it (off is faster)
OLLAMA_THINK=default
OLLAMA_KEEP_ALIVE=30m

# Any OpenAI-compatible server with tool calling: LM Studio (http://127.0.0.1:1234/v1),
# llama.cpp `llama-server --jinja` (http://127.0.0.1:8080/v1), or a hosted service.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_MAX_TOKENS=8192
# The server's context window in tokens (e.g. LM Studio "Context Length", llama-server -c). When set, older
# page text is shortened so requests fit. Leave empty for hosted services with large windows.
OPENAI_COMPAT_CONTEXT_TOKENS=
# Prices for cost limits when using a hosted OpenAI-compatible service (USD per million tokens)
MODEL_INPUT_PRICE_PER_MTOK=
MODEL_OUTPUT_PRICE_PER_MTOK=
MODEL_REQUEST_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------- web research
# brave | tavily | searxng | none
SEARCH_PROVIDER=brave
# https://brave.com/search/api/  (monthly free credit; then about $5 per 1,000 searches)
BRAVE_API_KEY=
# https://tavily.com  (free monthly credits)
TAVILY_API_KEY=
# Your own SearXNG instance with JSON output enabled, e.g. http://127.0.0.1:8888
SEARXNG_BASE_URL=

# Route outbound traffic (cloud model API, search API, page fetches, browser) through an HTTP proxy,
# for example a local VPN client at http://127.0.0.1:7890. Leave empty for direct connections.
OUTBOUND_PROXY=
# Only if your VPN client uses "fake-IP" DNS (e.g. Clash), allow its range: 198.18.0.0/15
FETCH_ALLOWED_EXTRA_CIDRS=
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=8000000
# Headless Chromium for JavaScript-heavy pages (install: uv run playwright install chromium)
BROWSER_ENABLED=true
BROWSER_TIMEOUT_SECONDS=30
# Optionally use installed Google Chrome instead of Playwright's Chromium: BROWSER_CHANNEL=chrome
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=

# ---------------------------------------------------------------- limits
MAX_CONCURRENT_TASKS=2
TASK_MAX_STEPS=30
TASK_MAX_TOOL_CALLS=60
TASK_MAX_SEARCHES=15
TASK_MAX_FETCHES=30
TASK_MAX_SECONDS=1500
TASK_MAX_TOKENS=3000000
# Spending caps (USD). Also editable in Settings.
TASK_MAX_COST_USD=1.50
DAILY_MAX_COST_USD=6.00

# ---------------------------------------------------------------- Gmail (optional)
# Google Cloud OAuth client ("Web application"). Scope requested: gmail.compose only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must match an authorized redirect URI of the OAuth client. Default:
# http://127.0.0.1:18789/api/integrations/gmail/callback
GMAIL_REDIRECT_URI=
# false = drafts only. true = allow sending, each email only after you approve its exact content.
GMAIL_ALLOW_SEND=false
